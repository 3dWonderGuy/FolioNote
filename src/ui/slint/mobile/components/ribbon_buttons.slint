// Reusable Ribbon UI Buttons & Primitives for Mobile & Tablet Touch Shell.
// Native, modern styling aligned with FolioNote warm brand orange and professional dark theme.

component RibbonTabButton inherits Rectangle {
    in property <string> label: "Draw";
    in property <bool> is_active: false;
    in property <bool> is_accent: false;
    callback clicked();

    height: 38px;
    min-width: 60px;
    preferred-width: txt.preferred-width + 24px;
    background: transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Hover background highlight
    if touch.has-hover && !root.is_active : Rectangle {
        x: 2px;
        y: 4px;
        width: parent.width - 4px;
        height: parent.height - 8px;
        border-radius: 6px;
        background: #FFFFFF10;
    }

    // Active Tab subtle pill background
    if root.is_active : Rectangle {
        x: 2px;
        y: 4px;
        width: parent.width - 4px;
        height: parent.height - 8px;
        border-radius: 6px;
        background: #252833;
    }

    txt := Text {
        text: root.label;
        font-size: 13px;
        font-weight: root.is_active ? 700 : 500;
        color: root.is_active ? #FFFFFF : (touch.has-hover ? #E2E8F0 : #94A3B8);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Signature Folio Orange Active Indicator Underline
    if root.is_active : Rectangle {
        x: 6px;
        y: parent.height - 3px;
        width: parent.width - 12px;
        height: 3px;
        border-radius: 1.5px;
        background: #EA580C;
    }
}

component RibbonLargeButton inherits Rectangle {
    in property <string> icon: "✒";
    in property <string> label: "Tool";
    in property <bool> is_selected: false;
    in property <color> active_color: #EA580C;
    in property <color> tool_color: transparent;
    in property <length> btn_width: 52px;
    callback clicked();

    width: root.btn_width;
    height: 56px;
    border-radius: 7px;
    background: is_selected ? #282B36 : (touch.pressed ? #343744 : (touch.has-hover ? #22242D : transparent));
    border-width: 1px;
    border-color: is_selected ? #404454 : (touch.has-hover ? #2E323E : transparent);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 5px;
        padding-left: 2px;
        padding-right: 2px;
        spacing: 3px;
        alignment: center;

        Text {
            text: root.icon;
            font-size: 16px;
            font-weight: root.is_selected ? 700 : 500;
            color: root.is_selected ? #FFFFFF : (touch.has-hover ? #F1F5F9 : #CBD5E1);
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            font-size: 10px;
            font-weight: root.is_selected ? 600 : 500;
            color: root.is_selected ? #EA580C : (touch.has-hover ? #E2E8F0 : #8E98A8);
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Active bottom accent line (Folio Orange or active tool inking color)
    if root.is_selected : Rectangle {
        x: 6px;
        y: parent.height - 3px;
        width: parent.width - 12px;
        height: 2px;
        border-radius: 1px;
        background: root.tool_color != transparent ? root.tool_color : root.active_color;
    }
}

component RibbonPillButton inherits Rectangle {
    in property <string> label: "1.0";
    in property <bool> is_selected: false;
    in property <length> pill_width: 38px;
    callback clicked();

    width: root.pill_width;
    height: 25px;
    border-radius: 5px;
    background: is_selected ? #EA580C : (touch.pressed ? #353846 : (touch.has-hover ? #2C2F3A : #21232B));
    border-width: 1px;
    border-color: is_selected ? #F97316 : #2F323D;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        font-size: 11px;
        font-weight: root.is_selected ? 700 : 500;
        color: root.is_selected ? #FFFFFF : (touch.has-hover ? #F1F5F9 : #94A3B8);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ColorSwatch inherits Rectangle {
    in property <color> swatch_color: #000000;
    in property <bool> is_selected: false;
    callback clicked();

    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: swatch_color;
    border-width: 1.5px;
    border-color: is_selected ? #FFFFFF : #ffffff30;

    if is_selected : Rectangle {
        x: 4px;
        y: 4px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: 1.5px;
        border-color: #FFFFFF90;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component RibbonGroupDivider inherits Rectangle {
    width: 1px;
    height: 50px;
    background: #282B35;
}

export { RibbonTabButton, RibbonLargeButton, RibbonPillButton, ColorSwatch, RibbonGroupDivider }
