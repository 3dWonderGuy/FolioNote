// Interactive Canvas Viewport Component (1:1 Physical Pixel Inking Surface).

export component CanvasViewport inherits TouchArea {
    in property <image> canvas_image;

    out property <int> viewport_w: Math.round(self.width / 1phx);
    out property <int> viewport_h: Math.round(self.height / 1phx);

    callback canvas_pointer_down(float, float, int);
    callback canvas_pointer_move(float, float, int);
    callback canvas_pointer_up(float, float, int);
    callback canvas_scroll(float, float, float, float);

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            if (event.button == PointerEventButton.middle) {
                root.canvas_pointer_down(self.mouse-x / 1phx, self.mouse-y / 1phx, 2);
            } else if (event.button == PointerEventButton.right) {
                root.canvas_pointer_down(self.mouse-x / 1phx, self.mouse-y / 1phx, 3);
            } else {
                root.canvas_pointer_down(self.mouse-x / 1phx, self.mouse-y / 1phx, 0);
            }
        } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
            root.canvas_pointer_up(self.mouse-x / 1phx, self.mouse-y / 1phx, 0);
        }
    }

    moved => {
        if (self.pressed) {
            root.canvas_pointer_move(self.mouse-x / 1phx, self.mouse-y / 1phx, 0);
        }
    }

    scroll-event(event) => {
        root.canvas_scroll(
            self.mouse-x / 1phx,
            self.mouse-y / 1phx,
            event.delta-x / 1phx,
            event.delta-y / 1phx
        );
        return EventResult.accept;
    }

    Image {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        source: root.canvas_image;
        image-fit: fill;
        image-rendering: smooth;
    }
}
