// FolioNote Mobile & Tablet Ribbon Shell
// Touch-first, responsive interface with full Legacy Ribbon parity (Home, Insert, Draw, View, Shapes)
// and 1:1 physical-pixel (1phx) zero-offset GPU/Blend2D canvas integration.

import { Button, ScrollView } from "std-widgets.slint";

export struct PageInfo {
    title: string,
    guid: string,
    is_active: bool,
}

export struct SectionInfo {
    title: string,
    guid: string,
    color_hex: string,
    is_active: bool,
}

component RibbonTabButton inherits Rectangle {
    in property <string> label: "Draw";
    in property <bool> is_active: false;
    in property <bool> is_accent: false;
    callback clicked();

    height: 32px;
    min-width: 64px;
    preferred-width: txt.preferred-width + 24px;
    border-radius: 6px;
    background: is_active ? #2563EB : (is_accent ? #1E3A8A90 : (touch.has-hover ? #33415590 : transparent));
    border-width: is_active ? 1px : 0px;
    border-color: #60A5FA;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    txt := Text {
        text: root.label;
        font-size: 13px;
        font-weight: root.is_active ? 700 : 600;
        color: root.is_active ? #FFFFFF : #CBD5E1;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component RibbonLargeButton inherits Rectangle {
    in property <string> icon: "✏";
    in property <string> label: "Tool";
    in property <bool> is_selected: false;
    in property <color> active_color: #2563EB;
    in property <length> btn_width: 54px;
    callback clicked();

    width: root.btn_width;
    height: 54px;
    border-radius: 8px;
    background: is_selected ? active_color : (touch.pressed ? #334155 : (touch.has-hover ? #1E293B : #0F172A90));
    border-width: is_selected ? 1.5px : 1px;
    border-color: is_selected ? #93C5FD : #33415580;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding-top: 5px;
        padding-bottom: 4px;
        padding-left: 2px;
        padding-right: 2px;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.icon;
            font-size: 17px;
            color: root.is_selected ? #FFFFFF : #F1F5F9;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            font-size: 10px;
            font-weight: root.is_selected ? 700 : 500;
            color: root.is_selected ? #FFFFFF : #94A3B8;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component RibbonPillButton inherits Rectangle {
    in property <string> label: "1.0";
    in property <bool> is_selected: false;
    in property <length> pill_width: 38px;
    callback clicked();

    width: root.pill_width;
    height: 24px;
    border-radius: 5px;
    background: is_selected ? #2563EB : (touch.has-hover ? #334155 : #1E293B);
    border-width: 1px;
    border-color: is_selected ? #60A5FA : #334155;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        font-size: 11px;
        font-weight: root.is_selected ? 700 : 500;
        color: root.is_selected ? #FFFFFF : #CBD5E1;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ColorSwatch inherits Rectangle {
    in property <color> swatch_color: #000000;
    in property <bool> is_selected: false;
    callback clicked();

    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: swatch_color;
    border-width: is_selected ? 2.5px : 1px;
    border-color: is_selected ? #38BDF8 : #ffffff50;

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component RibbonGroupDivider inherits Rectangle {
    width: 1px;
    height: 64px;
    background: #33415590;
}

export component FolioMobileShell inherits Window {
    title: "FolioNote";
    background: #18191C;
    preferred-width: 1100px;
    preferred-height: 780px;
    min-width: 360px;
    min-height: 480px;
    default-font-family: "Inter, Segoe UI, Roboto, sans-serif";

    // -------------------------------------------------------------------------
    // Canvas Rendering & 1:1 Physical Pixel Coordinate Properties
    // -------------------------------------------------------------------------
    in-out property <image> canvas_image;
    out property <int> canvas_viewport_w: Math.round(canvas_area.width / 1phx);
    out property <int> canvas_viewport_h: Math.round(canvas_area.height / 1phx);

    // Pointer & Scroll Callbacks in Physical Pixels (1phx) relative to canvas_area
    callback canvas_pointer_down(float, float, int);
    callback canvas_pointer_move(float, float, int);
    callback canvas_pointer_up(float, float, int);
    callback canvas_scroll(float, float, float, float);

    // -------------------------------------------------------------------------
    // Ribbon & Application State Properties
    // -------------------------------------------------------------------------
    in-out property <string> active_ribbon_tab: "draw"; // "home", "insert", "draw", "view", "shapes"
    in-out property <bool> ribbon_collapsed: false;

    in-out property <string> active_tool: "pen"; // "pen", "fountain", "pencil", "brush", "highlighter", "laser", "eraser", "point_eraser", "select", "lasso", "pan", "text", "shape"
    in-out property <string> active_shape_name: "rect";
    in-out property <color> active_color: #181A20;
    in-out property <float> stroke_width_mm: 0.5;
    in-out property <string> stroke_width_label: "0.5 mm";
    in-out property <int> opacity_pct: 100;
    in-out property <string> stroke_pattern: "solid"; // "solid", "dashed", "dotted"
    in-out property <string> eraser_size_label: "6 mm";

    in-out property <bool> ruler_enabled: false;
    in-out property <bool> auto_shapes_enabled: false;
    in-out property <bool> lock_shape_mode: false;
    in-out property <bool> snap_to_grid: false;

    in-out property <string> paper_style: "grid"; // "blank", "lined", "grid", "dotted"
    in-out property <bool> canvas_inverted: false;
    in-out property <bool> show_page_border: true;
    in-out property <string> zoom_label: "100%";

    in-out property <bool> text_bold: false;
    in-out property <bool> text_italic: false;
    in-out property <bool> text_underline: false;
    in-out property <bool> text_strike: false;

    in-out property <string> notebook_title: "Notebook";
    in-out property <string> section_title: "General";
    in-out property <string> page_title: "Untitled Page";
    in-out property <bool> drawer_open: false;

    in-out property <[SectionInfo]> sections: [];
    in-out property <[PageInfo]> pages: [];

    // -------------------------------------------------------------------------
    // C++ Action Callbacks
    // -------------------------------------------------------------------------
    callback select_tool(string);
    callback select_color(color);
    callback set_stroke_width(float);
    callback set_opacity_pct(int);
    callback set_stroke_pattern(string);
    callback trigger_undo();
    callback trigger_redo();
    callback ribbon_action(string);
    callback select_section(string);
    callback select_page(string);
    callback new_page_requested();
    callback switch_to_desktop_mode();

    // -------------------------------------------------------------------------
    // 1. TOP MOBILE-FRIENDLY LEGACY RIBBON BAR
    // -------------------------------------------------------------------------
    top_ribbon := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.ribbon_collapsed ? 42px : 126px;
        background: #0F172A;
        border-width: 1px;
        border-color: #1E293B;
        z: 10;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // -----------------------------------------------------------------
            // ROW 1: Quick Access + Ribbon Tabs + Page Title + Mode Controls
            // -----------------------------------------------------------------
            Rectangle {
                height: 42px;
                background: #090D16;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 6px;
                    alignment: space-between;

                    // Left: Drawer + Quick Undo/Redo + Tab Strip
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;

                        // Notebook Drawer Toggle
                        RibbonPillButton {
                            label: "☰ Pages";
                            pill_width: 68px;
                            is_selected: root.drawer_open;
                            clicked => { root.drawer_open = !root.drawer_open; }
                        }

                        // Quick Undo / Redo
                        RibbonPillButton {
                            label: "↩";
                            pill_width: 30px;
                            clicked => { root.trigger_undo(); }
                        }
                        RibbonPillButton {
                            label: "↪";
                            pill_width: 30px;
                            clicked => { root.trigger_redo(); }
                        }

                        Rectangle { width: 1px; height: 24px; background: #334155; }

                        RibbonTabButton {
                            label: "Home";
                            is_active: root.active_ribbon_tab == "home";
                            clicked => {
                                if (root.active_ribbon_tab == "home" && !root.ribbon_collapsed) {
                                    // already active
                                } else {
                                    root.active_ribbon_tab = "home";
                                    root.ribbon_collapsed = false;
                                }
                            }
                        }
                        RibbonTabButton {
                            label: "Insert";
                            is_active: root.active_ribbon_tab == "insert";
                            clicked => {
                                root.active_ribbon_tab = "insert";
                                root.ribbon_collapsed = false;
                            }
                        }
                        RibbonTabButton {
                            label: "Draw";
                            is_active: root.active_ribbon_tab == "draw";
                            clicked => {
                                root.active_ribbon_tab = "draw";
                                root.ribbon_collapsed = false;
                            }
                        }
                        RibbonTabButton {
                            label: "View";
                            is_active: root.active_ribbon_tab == "view";
                            clicked => {
                                root.active_ribbon_tab = "view";
                                root.ribbon_collapsed = false;
                            }
                        }
                        RibbonTabButton {
                            label: "Shapes";
                            is_active: root.active_ribbon_tab == "shapes";
                            is_accent: root.active_tool == "shape";
                            clicked => {
                                root.active_ribbon_tab = "shapes";
                                root.ribbon_collapsed = false;
                            }
                        }
                    }

                    // Right: Active Document Info + Collapse Toggle + Desktop Switch
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        Text {
                            text: root.notebook_title + "  ›  " + root.page_title;
                            font-size: 12px;
                            color: #94A3B8;
                            vertical-alignment: center;
                        }

                        RibbonPillButton {
                            label: root.ribbon_collapsed ? "▼ Expand" : "▲ Collapse";
                            pill_width: 72px;
                            is_selected: root.ribbon_collapsed;
                            clicked => { root.ribbon_collapsed = !root.ribbon_collapsed; }
                        }

                        RibbonPillButton {
                            label: "🖥 Desktop (F4)";
                            pill_width: 96px;
                            clicked => { root.switch_to_desktop_mode(); }
                        }
                    }
                }
            }

            // Divider line under tab bar
            Rectangle {
                height: 1px;
                background: #1E293B;
            }

            // -----------------------------------------------------------------
            // ROW 2: Horizontally Scrollable Mobile-Friendly Ribbon Shelf
            // -----------------------------------------------------------------
            if !root.ribbon_collapsed : Flickable {
                height: 83px;
                viewport-height: 83px;
                interactive: true;

                // =============================================================
                // TAB: DRAW (Legacy Draw Ribbon Parity)
                // =============================================================
                if root.active_ribbon_tab == "draw" : HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 4px;
                    spacing: 8px;
                    alignment: start;

                    // Group 1: History
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 4px;
                            RibbonLargeButton {
                                icon: "↩";
                                label: "Undo";
                                btn_width: 48px;
                                clicked => { root.trigger_undo(); }
                            }
                            RibbonLargeButton {
                                icon: "↪";
                                label: "Redo";
                                btn_width: 48px;
                                clicked => { root.trigger_redo(); }
                            }
                        }
                        Text { text: "History"; font-size: 9px; color: #64748B; horizontal-alignment: center; }
                    }

                    RibbonGroupDivider {}

                    // Group 2: Selection & Navigation
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 4px;
                            RibbonLargeButton {
                                icon: "🗑";
                                label: "Delete";
                                btn_width: 48px;
                                active_color: #DC2626;
                                clicked => { root.ribbon_action("delete_selected"); }
                            }
                            RibbonLargeButton {
                                icon: "⬚";
                                label: "Select";
                                btn_width: 48px;
                                is_selected: root.active_tool == "select";
                                active_color: #6366F1;
                                clicked => { root.active_tool = "select"; root.select_tool("select"); }
                            }
                            RibbonLargeButton {
                                icon: "✂";
                                label: "Lasso";
                                btn_width: 48px;
                                is_selected: root.active_tool == "lasso";
                                active_color: #8B5CF6;
                                clicked => { root.active_tool = "lasso"; root.select_tool("lasso"); }
                            }
                            RibbonLargeButton {
                                icon: "✋";
                                label: "Pan";
                                btn_width: 48px;
                                is_selected: root.active_tool == "pan";
                                active_color: #0EA5E9;
                                clicked => { root.active_tool = "pan"; root.select_tool("pan"); }
                            }
                            RibbonLargeButton {
                                icon: "T";
                                label: "Text";
                                btn_width: 48px;
                                is_selected: root.active_tool == "text";
                                active_color: #10B981;
                                clicked => { root.active_tool = "text"; root.select_tool("text"); }
                            }
                        }
                        Text { text: "Selection & Nav"; font-size: 9px; color: #64748B; horizontal-alignment: center; }
                    }

                    RibbonGroupDivider {}

                    // Group 3: Eraser Tools
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 4px;
                            RibbonLargeButton {
                                icon: "🧹";
                                label: "Stroke";
                                btn_width: 50px;
                                is_selected: root.active_tool == "eraser";
                                active_color: #EC4899;
                                clicked => { root.active_tool = "eraser"; root.select_tool("eraser"); }
                            }
                            RibbonLargeButton {
                                icon: "◯";
                                label: "Point";
                                btn_width: 50px;
                                is_selected: root.active_tool == "point_eraser";
                                active_color: #EC4899;
                                clicked => { root.active_tool = "point_eraser"; root.select_tool("point_eraser"); }
                            }
                            RibbonLargeButton {
                                icon: "◎";
                                label: root.eraser_size_label;
                                btn_width: 48px;
                                clicked => { root.ribbon_action("cycle_eraser_size"); }
                            }
                        }
                        Text { text: "Eraser"; font-size: 9px; color: #64748B; horizontal-alignment: center; }
                    }

                    RibbonGroupDivider {}

                    // Group 4: Drawing Pens & Brushes
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 4px;
                            RibbonLargeButton {
                                icon: "✏";
                                label: "Pen";
                                btn_width: 48px;
                                is_selected: root.active_tool == "pen";
                                active_color: #2563EB;
                                clicked => { root.active_tool = "pen"; root.select_tool("pen"); }
                            }
                            RibbonLargeButton {
                                icon: "✒";
                                label: "Fountain";
                                btn_width: 54px;
                                is_selected: root.active_tool == "fountain";
                                active_color: #2563EB;
                                clicked => { root.active_tool = "fountain"; root.select_tool("fountain"); }
                            }
                            RibbonLargeButton {
                                icon: "✎";
                                label: "Pencil";
                                btn_width: 48px;
                                is_selected: root.active_tool == "pencil";
                                active_color: #475569;
                                clicked => { root.active_tool = "pencil"; root.select_tool("pencil"); }
                            }
                            RibbonLargeButton {
                                icon: "🖌";
                                label: "Brush";
                                btn_width: 48px;
                                is_selected: root.active_tool == "brush";
                                active_color: #7C3AED;
                                clicked => { root.active_tool = "brush"; root.select_tool("brush"); }
                            }
                            RibbonLargeButton {
                                icon: "🖍";
                                label: "Highlight";
                                btn_width: 56px;
                                is_selected: root.active_tool == "highlighter";
                                active_color: #CA8A04;
                                clicked => { root.active_tool = "highlighter"; root.select_tool("highlighter"); }
                            }
                            RibbonLargeButton {
                                icon: "🔴";
                                label: "Laser";
                                btn_width: 48px;
                                is_selected: root.active_tool == "laser";
                                active_color: #EF4444;
                                clicked => { root.active_tool = "laser"; root.select_tool("laser"); }
                            }
                        }
                        Text { text: "Drawing Tools"; font-size: 9px; color: #64748B; horizontal-alignment: center; }
                    }

                    RibbonGroupDivider {}

                    // Group 5: Colors (2x5 Palette)
                    VerticalLayout {
                        spacing: 2px;
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 5px;
                                ColorSwatch {
                                    swatch_color: #181A20;
                                    is_selected: root.active_color == #181A20;
                                    clicked => { root.active_color = #181A20; root.select_color(#181A20); }
                                }
                                ColorSwatch {
                                    swatch_color: #1E3A8A;
                                    is_selected: root.active_color == #1E3A8A;
                                    clicked => { root.active_color = #1E3A8A; root.select_color(#1E3A8A); }
                                }
                                ColorSwatch {
                                    swatch_color: #2563EB;
                                    is_selected: root.active_color == #2563EB;
                                    clicked => { root.active_color = #2563EB; root.select_color(#2563EB); }
                                }
                                ColorSwatch {
                                    swatch_color: #DC2626;
                                    is_selected: root.active_color == #DC2626;
                                    clicked => { root.active_color = #DC2626; root.select_color(#DC2626); }
                                }
                                ColorSwatch {
                                    swatch_color: #16A34A;
                                    is_selected: root.active_color == #16A34A;
                                    clicked => { root.active_color = #16A34A; root.select_color(#16A34A); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                ColorSwatch {
                                    swatch_color: #D97706;
                                    is_selected: root.active_color == #D97706;
                                    clicked => { root.active_color = #D97706; root.select_color(#D97706); }
                                }
                                ColorSwatch {
                                    swatch_color: #9333EA;
                                    is_selected: root.active_color == #9333EA;
                                    clicked => { root.active_color = #9333EA; root.select_color(#9333EA); }
                                }
                                ColorSwatch {
                                    swatch_color: #EC4899;
                                    is_selected: root.active_color == #EC4899;
                                    clicked => { root.active_color = #EC4899; root.select_color(#EC4899); }
                                }
                                ColorSwatch {
                                    swatch_color: #0D9488;
                                    is_selected: root.active_color == #0D9488;
                                    clicked => { root.active_color = #0D9488; root.select_color(#0D9488); }
                                }
                                ColorSwatch {
                                    swatch_color: #FACC15;
                                    is_selected: root.active_color == #FACC15;
                                    clicked => { root.active_color = #FACC15; root.select_color(#FACC15); }
                                }
                            }
                        }
                        Text { text: "Colors"; font-size: 9px; color: #64748B; horizontal-alignment: center; }
                    }

                    RibbonGroupDivider {}

                    // Group 6: Thickness, Opacity & Stroke Style
                    VerticalLayout {
                        spacing: 2px;
                        VerticalLayout {
                            spacing: 4px;
                            // Top row: Thickness presets
                            HorizontalLayout {
                                spacing: 3px;
                                RibbonPillButton {
                                    label: "0.3";
                                    pill_width: 32px;
                                    is_selected: root.stroke_width_label == "0.3 mm";
                                    clicked => { root.stroke_width_mm = 0.3; root.stroke_width_label = "0.3 mm"; root.set_stroke_width(0.3); }
                                }
                                RibbonPillButton {
                                    label: "0.5";
                                    pill_width: 32px;
                                    is_selected: root.stroke_width_label == "0.5 mm";
                                    clicked => { root.stroke_width_mm = 0.5; root.stroke_width_label = "0.5 mm"; root.set_stroke_width(0.5); }
                                }
                                RibbonPillButton {
                                    label: "1.0";
                                    pill_width: 32px;
                                    is_selected: root.stroke_width_label == "1.0 mm";
                                    clicked => { root.stroke_width_mm = 1.0; root.stroke_width_label = "1.0 mm"; root.set_stroke_width(1.0); }
                                }
                                RibbonPillButton {
                                    label: "2.5";
                                    pill_width: 32px;
                                    is_selected: root.stroke_width_label == "2.5 mm";
                                    clicked => { root.stroke_width_mm = 2.5; root.stroke_width_label = "2.5 mm"; root.set_stroke_width(2.5); }
                                }
                                RibbonPillButton {
                                    label: "5.0";
                                    pill_width: 32px;
                                    is_selected: root.stroke_width_label == "5.0 mm";
                                    clicked => { root.stroke_width_mm = 5.0; root.stroke_width_label = "5.0 mm"; root.set_stroke_width(5.0); }
                                }
                            }
                            // Bottom row: Opacity & Line Pattern
                            HorizontalLayout {
                                spacing: 3px;
                                RibbonPillButton {
                                    label: "100%";
                                    pill_width: 38px;
                                    is_selected: root.opacity_pct == 100;
                                    clicked => { root.opacity_pct = 100; root.set_opacity_pct(100); }
                                }
                                RibbonPillButton {
                                    label: "50%";
                                    pill_width: 34px;
                                    is_selected: root.opacity_pct == 50;
                                    clicked => { root.opacity_pct = 50; root.set_opacity_pct(50); }
                                }
                                RibbonPillButton {
                                    label: "───";
                                    pill_width: 30px;
                                    is_selected: root.stroke_pattern == "solid";
                                    clicked => { root.stroke_pattern = "solid"; root.set_stroke_pattern("solid"); }
                                }
                                RibbonPillButton {
                                    label: "- - -";
                                    pill_width: 30px;
                                    is_selected: root.stroke_pattern == "dashed";
                                    clicked => { root.stroke_pattern = "dashed"; root.set_stroke_pattern("dashed"); }
                                }
                                RibbonPillButton {
                                    label: "· · ·";
                                    pill_width: 30px;
                                    is_selected: root.stroke_pattern == "dotted";
                                    clicked => { root.stroke_pattern = "dotted"; root.set_stroke_pattern("dotted"); }
                                }
                            }
                        }
                        Text { text: "Thickness & Style"; font-size: 9px; color: #64748B; horizontal-alignment: center; }
                    }

                    RibbonGroupDivider {}

                    // Group 7: Ruler & Quick Shapes
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 4px;
                            RibbonLargeButton {
                                icon: "📏";
                                label: "Ruler";
                                btn_width: 48px;
                                is_selected: root.ruler_enabled;
                                active_color: #0284C7;
                                clicked => { root.ribbon_action("toggle_ruler"); }
                            }
                            RibbonLargeButton {
                                icon: "╱";
                                label: "Line";
                                btn_width: 46px;
                                is_selected: root.active_tool == "shape" && root.active_shape_name == "line";
                                clicked => {
                                    root.active_tool = "shape";
                                    root.active_shape_name = "line";
                                    root.ribbon_action("shape_line");
                                }
                            }
                            RibbonLargeButton {
                                icon: "↗";
                                label: "Arrow";
