// FolioNote Mobile & Tablet Touch Shell Runner Window
// Modular architecture: Main Menu / Hub, Toolbar, Sidebars, Canvas Viewport and Presentation Controls.

import { PageInfo, SectionInfo, NotebookItem, LibraryFolderItem, CustomButtonAction } from "types.slint";
import { RibbonToolbar } from "toolbar/ribbon_toolbar.slint";
import { NavigationDrawer } from "sidebar/navigation_drawer.slint";
import { CanvasViewport } from "canvas/canvas_viewport.slint";
import { MainMenuPage } from "hub/main_menu_page.slint";

export { PageInfo, SectionInfo, NotebookItem, LibraryFolderItem, CustomButtonAction }

export component FolioMobileShell inherits Window {
    title: "FolioNote";
    background: #18191C;
    preferred-width: 1100px;
    preferred-height: 780px;
    min-width: 360px;
    min-height: 480px;
    default-font-family: "Inter, Segoe UI, Roboto, sans-serif";

    // -------------------------------------------------------------------------
    // Canvas Inking Surface Properties & Callbacks (1:1 Physical Pixels)
    // -------------------------------------------------------------------------
    in-out property <image> canvas_image <=> viewport.canvas_image;
    out property <int> canvas_viewport_w: viewport.viewport_w;
    out property <int> canvas_viewport_h: viewport.viewport_h;

    callback canvas_pointer_down(float, float, int);
    callback canvas_pointer_move(float, float, int);
    callback canvas_pointer_up(float, float, int);
    callback canvas_scroll(float, float, float, float);

    // -------------------------------------------------------------------------
    // Main Menu / Hub Properties
    // -------------------------------------------------------------------------
    in-out property <bool> main_menu_open: false;
    in-out property <string> hub_active_category: "notebooks";
    in-out property <string> library_root_path: "";
    in-out property <[NotebookItem]> notebooks: [];
    in-out property <[LibraryFolderItem]> libraries: [];

    in-out property <bool> dynamic_pressure: true;
    in-out property <bool> palm_rejection: true;
    in-out property <string> ink_smoothing: "medium";

    // -------------------------------------------------------------------------
    // Ribbon & Application State Properties
    // -------------------------------------------------------------------------
    in-out property <string> active_ribbon_tab: "draw";
    in-out property <bool> ribbon_collapsed: false;

    in-out property <string> active_tool: "pen";
    in-out property <string> active_shape_name: "rect";
    in-out property <color> active_color: #181A20;
    in-out property <float> stroke_width_mm: 0.5;
    in-out property <string> stroke_width_label: "0.5 mm";
    in-out property <int> opacity_pct: 100;
    in-out property <string> stroke_pattern: "solid";
    in-out property <string> eraser_size_label: "6 mm";

    in-out property <bool> ruler_enabled: false;
    in-out property <bool> auto_shapes_enabled: false;
    in-out property <bool> lock_shape_mode: false;
    in-out property <bool> snap_to_grid: false;

    in-out property <string> paper_style: "grid";
    in-out property <bool> canvas_inverted: false;
    in-out property <bool> show_page_border: true;
    in-out property <string> zoom_label: "100%";

    in-out property <bool> text_bold: false;
    in-out property <bool> text_italic: false;
    in-out property <bool> text_underline: false;
    in-out property <bool> text_strike: false;

    in-out property <string> notebook_title: "Notebook";
    in-out property <string> section_title: "General";
    in-out property <string> page_title: "Untitled Page";
    in-out property <bool> drawer_open: false;

    in-out property <[SectionInfo]> sections: [];
    in-out property <[PageInfo]> pages: [];

    // -------------------------------------------------------------------------
    // C++ Host Callbacks
    // -------------------------------------------------------------------------
    callback toggle_main_menu();
    callback select_notebook(string);
    callback create_notebook(string, color);
    callback delete_notebook(string);
    callback export_pdf();
    callback export_images();
    callback toggle_dynamic_pressure();
    callback toggle_palm_rejection();
    callback set_ink_smoothing(string);

    callback select_tool(string);
    callback select_color(color);
    callback set_stroke_width(float);
    callback set_opacity_pct(int);
    callback set_stroke_pattern(string);
    callback trigger_undo();
    callback trigger_redo();
    callback ribbon_action(string);
    callback select_section(string);
    callback select_page(string);
    callback new_page_requested();
    callback switch_to_desktop_mode();

    // -------------------------------------------------------------------------
    // 1. TOP RIBBON TOOLBAR
    // -------------------------------------------------------------------------
    toolbar := RibbonToolbar {
        x: 0px;
        y: 0px;
        width: parent.width;
        z: 10;
        active_tab <=> root.active_ribbon_tab;
        ribbon_collapsed <=> root.ribbon_collapsed;
        drawer_open <=> root.drawer_open;
        main_menu_open <=> root.main_menu_open;

        active_tool <=> root.active_tool;
        active_color <=> root.active_color;
        stroke_width_mm <=> root.stroke_width_mm;
        stroke_width_label <=> root.stroke_width_label;
        opacity_pct <=> root.opacity_pct;
        stroke_pattern <=> root.stroke_pattern;
        eraser_size_label <=> root.eraser_size_label;
        ruler_enabled <=> root.ruler_enabled;
        active_shape_name <=> root.active_shape_name;
        lock_shape_mode <=> root.lock_shape_mode;
        snap_to_grid <=> root.snap_to_grid;

        text_bold <=> root.text_bold;
        text_italic <=> root.text_italic;
        text_underline <=> root.text_underline;
        text_strike <=> root.text_strike;

        zoom_label <=> root.zoom_label;
        paper_style <=> root.paper_style;
        canvas_inverted <=> root.canvas_inverted;
        show_page_border <=> root.show_page_border;

        notebook_title: root.notebook_title;
        page_title: root.page_title;

        toggle_main_menu => {
            root.main_menu_open = !root.main_menu_open;
            root.toggle_main_menu();
        }
        toggle_drawer => { root.drawer_open = !root.drawer_open; }
        trigger_undo => { root.trigger_undo(); }
        trigger_redo => { root.trigger_redo(); }
        switch_to_desktop => { root.switch_to_desktop_mode(); }
        select_tool(t) => { root.select_tool(t); }
        select_color(c) => { root.select_color(c); }
        set_stroke_width(w) => { root.set_stroke_width(w); }
        set_opacity_pct(p) => { root.set_opacity_pct(p); }
        set_stroke_pattern(pat) => { root.set_stroke_pattern(pat); }
        ribbon_action(act) => { root.ribbon_action(act); }
        new_page_requested => { root.new_page_requested(); }
    }

    // -------------------------------------------------------------------------
    // 2. INTERACTIVE CANVAS VIEWPORT
    // -------------------------------------------------------------------------
    viewport := CanvasViewport {
        x: 0px;
        y: toolbar.height;
        width: parent.width;
        height: parent.height - toolbar.height;

        canvas_pointer_down(x, y, btn) => { root.canvas_pointer_down(x, y, btn); }
        canvas_pointer_move(x, y, btn) => { root.canvas_pointer_move(x, y, btn); }
        canvas_pointer_up(x, y, btn) => { root.canvas_pointer_up(x, y, btn); }
        canvas_scroll(x, y, dx, dy) => { root.canvas_scroll(x, y, dx, dy); }
    }

    // -------------------------------------------------------------------------
    // 3. SCRIM BACKDROP FOR NAVIGATION DRAWER
    // -------------------------------------------------------------------------
    if root.drawer_open : Rectangle {
        x: 0px;
        y: toolbar.height;
        width: parent.width;
        height: parent.height - toolbar.height;
        background: #00000070;
        z: 20;

        TouchArea {
            clicked => { root.drawer_open = false; }
        }
    }

    // -------------------------------------------------------------------------
    // 4. NAVIGATION DRAWER SIDEBAR
    // -------------------------------------------------------------------------
    drawer := NavigationDrawer {
        drawer_open <=> root.drawer_open;
        x: root.drawer_open ? 0px : -340px;
        y: toolbar.height;
        width: 320px;
        height: parent.height - toolbar.height;
        notebook_title: root.notebook_title;
        sections: root.sections;
        pages: root.pages;

        close_drawer => { root.drawer_open = false; }
        select_section(guid) => { root.select_section(guid); }
        select_page(guid) => { root.select_page(guid); }
        new_page_requested => { root.new_page_requested(); }
        switch_to_desktop => { root.switch_to_desktop_mode(); }
    }

    // -------------------------------------------------------------------------
    // 5. FULL-SCREEN MAIN MENU / NOTEBOOK HUB PAGE
    // -------------------------------------------------------------------------
    if root.main_menu_open : MainMenuPage {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        z: 50;

        active_category <=> root.hub_active_category;
        notebook_title: root.notebook_title;
        library_root_path: root.library_root_path;
        notebooks: root.notebooks;
        libraries: root.libraries;

        dynamic_pressure <=> root.dynamic_pressure;
        palm_rejection <=> root.palm_rejection;
        ink_smoothing <=> root.ink_smoothing;
        canvas_inverted <=> root.canvas_inverted;
        show_page_border <=> root.show_page_border;
        paper_style <=> root.paper_style;

        close_main_menu => { root.main_menu_open = false; }
        select_notebook(guid) => { root.select_notebook(guid); }
        create_notebook(name, col) => { root.create_notebook(name, col); }
        delete_notebook(guid) => { root.delete_notebook(guid); }
        switch_to_desktop => { root.switch_to_desktop_mode(); }
        export_pdf => { root.export_pdf(); }
        export_images => { root.export_images(); }
        toggle_dynamic_pressure => { root.toggle_dynamic_pressure(); }
        toggle_palm_rejection => { root.toggle_palm_rejection(); }
        set_ink_smoothing(lvl) => { root.set_ink_smoothing(lvl); }
        toggle_invert_canvas => { root.ribbon_action("toggle_invert_canvas"); }
        toggle_page_border => { root.ribbon_action("toggle_page_border"); }
        set_paper_style(st) => { root.ribbon_action("paper_" + st); }
    }
}
