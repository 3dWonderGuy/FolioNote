    // -------------------------------------------------------------------------
    // 2. INTERACTIVE CANVAS VIEWPORT (1:1 Physical Pixel Mapping)
    // -------------------------------------------------------------------------
    canvas_area := TouchArea {
        x: 0px;
        y: top_ribbon.height;
        width: parent.width;
        height: parent.height - top_ribbon.height;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.middle) {
                    root.canvas_pointer_down(self.mouse-x / 1phx, self.mouse-y / 1phx, 2);
                } else if (event.button == PointerEventButton.right) {
                    root.canvas_pointer_down(self.mouse-x / 1phx, self.mouse-y / 1phx, 3);
                } else {
                    root.canvas_pointer_down(self.mouse-x / 1phx, self.mouse-y / 1phx, 0);
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.canvas_pointer_up(self.mouse-x / 1phx, self.mouse-y / 1phx, 0);
            }
        }
        moved => {
            if (self.pressed) {
                root.canvas_pointer_move(self.mouse-x / 1phx, self.mouse-y / 1phx, 0);
            }
        }
        scroll-event(event) => {
            root.canvas_scroll(
                self.mouse-x / 1phx,
                self.mouse-y / 1phx,
                event.delta-x / 1phx,
                event.delta-y / 1phx
            );
            return EventResult.accept;
        }

        Image {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            source: root.canvas_image;
            image-fit: fill;
            image-rendering: smooth;
        }
    }

    // -------------------------------------------------------------------------
    // 3. SCRIM / BACKDROP FOR NAVIGATION DRAWER
    // -------------------------------------------------------------------------
    if root.drawer_open : Rectangle {
        x: 0px;
        y: top_ribbon.height;
        width: parent.width;
        height: parent.height - top_ribbon.height;
        background: #00000070;
        z: 20;

        TouchArea {
            clicked => { root.drawer_open = false; }
        }
    }

    // -------------------------------------------------------------------------
    // 4. SLIDE-OUT NAVIGATION DRAWER (Left Edge, 320px wide)
    // -------------------------------------------------------------------------
    drawer := Rectangle {
        x: root.drawer_open ? 0px : -340px;
        y: top_ribbon.height;
        width: 320px;
        height: parent.height - top_ribbon.height;
        background: #0F172AF5;
        border-width: 1px;
        border-color: #33415580;
        z: 30;
        animate x { duration: 180ms; easing: ease-out; }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Header Title
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.notebook_title;
                    font-size: 18px;
                    font-weight: 700;
                    color: #F8FAFC;
                }
                TouchArea {
                    width: 28px;
                    height: 28px;
                    clicked => { root.drawer_open = false; }
                    Text {
                        text: "✕";
                        font-size: 16px;
                        color: #94A3B8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle { height: 1px; background: #334155; }

            // Section Label
            Text {
                text: "SECTIONS";
                font-size: 11px;
                font-weight: 700;
                color: #64748B;
            }

            // Section Tabs
            Flickable {
                height: 36px;
                viewport-height: 36px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for sec in root.sections : Rectangle {
                        height: 32px;
                        min-width: 72px;
                        preferred-width: sec_txt.preferred-width + 24px;
                        border-radius: 16px;
                        background: sec.is_active ? #2563EB : #1E293B;
                        border-width: 1px;
                        border-color: sec.is_active ? #60A5FA : #334155;

                        TouchArea {
                            clicked => { root.select_section(sec.guid); }
                        }

                        sec_txt := Text {
                            text: sec.title;
                            font-size: 12px;
                            font-weight: sec.is_active ? 700 : 500;
                            color: sec.is_active ? #ffffff : #94A3B8;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #334155; }

            // Pages List Header
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "PAGES";
                    font-size: 11px;
                    font-weight: 700;
                    color: #64748B;
                }
                TouchArea {
                    width: 84px;
                    height: 24px;
                    clicked => { root.new_page_requested(); }
                    Text {
                        text: "+ New Page";
                        font-size: 12px;
                        font-weight: 600;
                        color: #38BDF8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Pages ScrollView
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 4px;
                    alignment: start;
                    for pg in root.pages : Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: pg.is_active ? #1E293B : transparent;
                        border-width: pg.is_active ? 1px : 0px;
                        border-color: #38BDF8;

                        TouchArea {
                            clicked => { root.select_page(pg.guid); root.drawer_open = false; }
                        }

                        Text {
                            x: 12px;
                            y: (parent.height - self.height) / 2;
                            text: pg.title;
                            font-size: 13px;
                            font-weight: pg.is_active ? 600 : 400;
                            color: pg.is_active ? #F8FAFC : #94A3B8;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #334155; }

            // Desktop Mode Switcher (F4)
            Rectangle {
                height: 42px;
                border-radius: 10px;
                background: #2563EB25;
                border-width: 1px;
                border-color: #2563EB60;

                TouchArea {
                    clicked => { root.switch_to_desktop_mode(); }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        text: "🖥 Switch to Desktop ImGui UI (F4)";
                        font-size: 13px;
                        font-weight: 600;
                        color: #60A5FA;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
