{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FolioNote (Debug Build)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/FolioNote",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}/build/bin",
            "preLaunchTask": "Build FolioNote (Debug)",
            "linux": {
                "program": "${workspaceFolder}/build/bin/FolioNote",
                "cwd": "${workspaceFolder}/build/bin"
            },
            "windows": {
                "program": "${workspaceFolder}/build/bin/Debug/FolioNote.exe",
                "cwd": "${workspaceFolder}/build/bin/Debug"
            }
        },
        {
            "name": "Debug FolioNote (RelWithDebInfo - Fast + Debug Symbols)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/FolioNote",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}/build/bin",
            "preLaunchTask": "Build FolioNote (RelWithDebInfo)",
            "linux": {
                "program": "${workspaceFolder}/build/bin/FolioNote",
                "cwd": "${workspaceFolder}/build/bin"
            },
            "windows": {
                "program": "${workspaceFolder}/build/bin/RelWithDebInfo/FolioNote.exe",
                "cwd": "${workspaceFolder}/build/bin/RelWithDebInfo"
            }
        },
        {
            "name": "Run FolioNote Without Rebuilding",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/FolioNote",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}/build/bin",
            "linux": {
                "program": "${workspaceFolder}/build/bin/FolioNote",
                "cwd": "${workspaceFolder}/build/bin"
            },
            "windows": {
                "program": "${workspaceFolder}/build/bin/Debug/FolioNote.exe",
                "cwd": "${workspaceFolder}/build/bin/Debug"
            }
        },
        {
            "name": "Attach to Running FolioNote",
            "type": "lldb",
            "request": "attach",
            "pid": "${command:pickProcess}"
        }
    ]
}